# Shell scripts and systemd units are copied verbatim onto a Debian system: a
# CRLF here becomes a "bad interpreter" there.
*.sh text eol=lf
*.service text eol=lf
*.path text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.nft text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
VERSION text eol=lf

*.png binary
*.img binary
*.xz binary

# Keeps design mockups and the lockfile out of pull-request diffs.
design/* linguist-documentation
frontend/package-lock.json -diff linguist-generated

# OnionPi transparent client configuration. Managed by install.sh.
ClientOnly 1
AvoidDiskWrites 1

SocksPort 127.0.0.1:9050 IsolateSOCKSAuth
TransPort __GATEWAY_IP__:9040 IsolateClientAddr IsolateDestAddr IsolateDestPort
# Port 5353 is claimed by avahi-daemon for mDNS; 9053 keeps the two apart.
DNSPort 127.0.0.1:9053
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 10.192.0.0/10
SafeLogging 1

ControlPort 127.0.0.1:9051
CookieAuthentication 1
CookieAuthFile /run/tor/control.authcookie
CookieAuthFileGroupReadable 1

Log notice syslog

# Bridges and pluggable transports. The file is generated by the OnionPi web
# interface, which owns it and asks Tor to reload after each change. It always
# exists: an empty include would abort Tor's configuration check.
%include /etc/onionpi/tor/bridges.conf

# Exit-node policy (country pinning). Same ownership and same rules as the
# bridge fragment above, and equally mandatory: it always exists.
%include /etc/onionpi/tor/policy.conf

#!/usr/sbin/nft -f

define onionpi_lan_if = "__WIFI_INTERFACE__"
define onionpi_lan_net = __LAN_NETWORK__
define onionpi_mesh_if = "bat0"
define onionpi_mesh_net = 10.43.0.0/16
define onionpi_trans_port = 9040

table inet onionpi {
  # Filled by onionpi-devices-apply from /var/lib/onionpi/blocked-macs.txt,
  # which the web interface writes. Empty right after a rule reload.
  set blocked_clients {
    type ether_addr
  }

  # Per-client byte counters, sampled by onionpi-accounting. An element is
  # created the first time a client is seen, and the whole set is recreated
  # empty by every rule reload: these are the bytes since the last load, never
  # a lifetime total. The web interface accumulates them on its side.
  set client_upload {
    type ether_addr
    size 512
    flags dynamic
    counter
  }

  # Traffic the Pi sends back to a client is generated locally, and the
  # destination MAC is only resolved after postrouting. Keying the download
  # counter on the address the DHCP server handed out is the only reading
  # available there; the interface maps it back to a MAC.
  set client_download {
    type ipv4_addr
    size 512
    flags dynamic
    counter
  }

  chain client_guard {
    type filter hook prerouting priority raw; policy accept;
    # A blocked device loses everything, DHCP included: it simply stops
    # existing for this router.
    iifname $onionpi_lan_if ether saddr @blocked_clients counter drop
  }

  chain client_upload_accounting {
    # Just after client_guard, so a blocked device is never accounted for.
    type filter hook prerouting priority raw + 10; policy accept;
    iifname $onionpi_lan_if update @client_upload { ether saddr counter }
  }

  chain client_download_accounting {
    type filter hook postrouting priority srcnat + 10; policy accept;
    oifname $onionpi_lan_if update @client_download { ip daddr counter }
  }

  chain tor_prerouting {
    type nat hook prerouting priority dstnat - 5; policy accept;

    # Keep local administration and LAN destinations local.
    iifname $onionpi_lan_if ip daddr $onionpi_lan_net return

    # Capture hard-coded DNS resolvers before the generic TCP rule.
    iifname $onionpi_lan_if udp dport 53 redirect to :53
    iifname $onionpi_lan_if tcp dport 53 redirect to :53

    # Tor TransPort supports TCP only. Every other forwarded protocol is
    # stopped by the kill switch below.
    iifname $onionpi_lan_if meta l4proto tcp redirect to :$onionpi_trans_port
  }

  chain kill_switch {
    type filter hook forward priority filter - 5; policy accept;
    # Nothing is ever routed between the access point and the upstream link.
    # Client traffic only leaves this machine through Tor's own sockets.
    iifname $onionpi_lan_if counter drop
    oifname $onionpi_lan_if counter drop

    # The mesh is an administration/backhaul plane, never another WAN. Even a
    # peer with a forged default route cannot forward through this node.
    iifname $onionpi_mesh_if counter drop
    oifname $onionpi_mesh_if counter drop
  }

  chain lan_input {
    # Reached only for packets coming from the access point, after the
    # prerouting redirects above have rewritten the destination port.
    ct state established,related accept
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } accept
    udp dport { 53, 67, 5353 } accept
    tcp dport { 53, 80, 443 } accept
    tcp dport $onionpi_trans_port accept
__LAN_SSH_RULE__
    counter drop
  }

  chain mesh_input {
    # A mesh peer may administer this OnionPi, discover it with mDNS and test
    # reachability. Tor's SOCKS, ControlPort and TransPort remain unreachable.
    ct state established,related accept
    ip saddr $onionpi_mesh_net ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } accept
    ip saddr $onionpi_mesh_net udp dport 5353 accept
    ip saddr $onionpi_mesh_net tcp dport { 80, 443 } accept
__MESH_SSH_RULE__
    counter drop
  }

  chain protect_local {
    type filter hook input priority filter - 5; policy accept;
    # Default-deny for Wi-Fi clients: SOCKS (9050), ControlPort (9051), the
    # private app port (8080) and any other daemon on this host stay
    # unreachable. HTTPS is terminated by nginx on 443.
    iifname $onionpi_lan_if jump lan_input
    iifname $onionpi_mesh_if jump mesh_input
  }
}

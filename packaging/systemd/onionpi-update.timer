[Unit]
Description=OnionPi update schedule
Documentation=file:/opt/onionpi/README.md

[Timer]
# These two values are the fallback. The real schedule lives in the drop-in
# /etc/systemd/system/onionpi-update.timer.d/schedule.conf, regenerated by
# `onionpi-update --write-timer` from /etc/onionpi/update.conf and from the
# hours chosen in the web interface.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=45m
# A Raspberry Pi that was unplugged at the scheduled hour still updates.
Persistent=true
AccuracySec=1min
Unit=onionpi-update.service

[Install]
WantedBy=timers.target

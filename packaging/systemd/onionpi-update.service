[Unit]
Description=Applies the OnionPi update policy
Documentation=file:/opt/onionpi/current/README.md
After=network-online.target tor.service onionpi-update-recover.service
Wants=network-online.target onionpi-update-recover.service
# Downloads go through the Tor SOCKS port, so a stopped Tor means no update
# rather than a clear-text request to GitHub.
ConditionPathExists=/usr/local/sbin/onionpi-update

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/onionpi-update --apply
# Fetching over Tor, unpacking, reinstalling the virtualenv and running the
# health check comfortably exceeds the default 90 seconds.
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
